.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Virtual environments and secrets
.env
.env.*
!.env.example
.venv/
.venv-*/
venv/
env/
ENV/

# Logs and temporary files
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Operating systems and IDEs
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.iml

